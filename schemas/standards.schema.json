{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pqc.silastron.com/schemas/standards.schema.json",
  "title": "Tracked standards and drafts",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "body", "status", "status_date", "source_url", "verified_on"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "title": { "type": "string", "minLength": 1 },
      "body": { "enum": ["NIST", "IETF"] },
      "group": { "type": "string", "description": "IETF working group acronym" },
      "datatracker_name": { "type": "string", "pattern": "^draft-[a-z0-9-]+$" },
      "status": {
        "enum": [
          "final", "draft", "in-development",
          "wg-draft", "iesg-evaluation", "rfc-ed-queue", "rfc-published",
          "unverified"
        ]
      },
      "rfc": { "type": "string", "pattern": "^RFC [0-9]+$" },
      "status_date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "source_url": { "type": "string", "pattern": "^https://[^\\s]+$" },
      "verified_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "note": { "type": "string", "maxLength": 500 }
    },
    "allOf": [
      {
        "if": { "properties": { "body": { "const": "IETF" } } },
        "then": { "required": ["datatracker_name", "group"] }
      }
    ]
  }
}
