{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pqc.silastron.com/schemas/changelog.schema.json",
  "title": "Append-only changelog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "kind", "subject_type", "subject_id", "title", "detected_by"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "kind": { "enum": ["release", "draft-revision", "draft-state", "status-change", "tracking-began", "planned-expired"] },
          "subject_type": { "enum": ["implementation", "standard", "tracker"] },
          "subject_id": { "type": "string", "minLength": 1 },
          "algorithm": { "enum": ["mlkem", "mldsa", "slhdsa", "hybrid_kex"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "from": { "type": ["string", "null"] },
          "to": { "type": ["string", "null"] },
          "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
          "detected_by": { "enum": ["machine", "human"] },
          "human_confirmed": { "type": "boolean" }
        }
      }
    }
  }
}
