{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pqc.silastron.com/schemas/collection-status.schema.json",
  "title": "Outcome of the most recent collection run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "last_good_collected_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "status": { "enum": ["ok", "failed"] },
    "last_good_collected_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$" },
    "failed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$" },
    "error": { "type": "string", "maxLength": 500 }
  }
}
